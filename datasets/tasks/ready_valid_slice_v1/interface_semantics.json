{
  "schema_version": "1.0",
  "task_id": "ready_valid_slice_v1",
  "module_name": "ready_valid_slice",
  "clock": {
    "port": "clk",
    "active_edge": "posedge",
    "input_sampling": "immediately_before_active_edge",
    "registered_output_observation": "immediately_after_active_edge"
  },
  "reset": {
    "port": "rst",
    "type": "synchronous",
    "active_level": "high",
    "priority": "highest",
    "out_valid_after_reset": 0,
    "out_data_after_reset": 0
  },
  "parameters": {
    "DATA_WIDTH": {"type": "positive_integer", "default": 8}
  },
  "ports": {
    "in_valid": {"direction": "input", "width": 1},
    "in_ready": {"direction": "output", "width": 1},
    "in_data": {"direction": "input", "width": "DATA_WIDTH"},
    "out_valid": {"direction": "output", "width": 1},
    "out_ready": {"direction": "input", "width": 1},
    "out_data": {"direction": "output", "width": "DATA_WIDTH"}
  },
  "flag_semantics": {
    "out_valid": "current_entry_occupied",
    "in_ready": "!out_valid || out_ready"
  },
  "acceptance": {
    "input_transfer": "in_valid && in_ready",
    "output_transfer": "out_valid && out_ready",
    "simultaneous_when_full": "consume_old_output_and_store_new_input",
    "when_full_and_blocked": "reject_input_and_hold_output",
    "when_empty": "accept_input_without_combinational_output_bypass"
  },
  "read_data": {
    "latency_cycles": 1,
    "no_bypass": true,
    "stability": "out_valid and out_data hold while out_valid && !out_ready"
  }
}
