{
  "schema_version": "1.0",
  "task_id": "ready_valid_fifo2_v1",
  "module_name": "ready_valid_fifo2",
  "clock": {
    "port": "clk",
    "active_edge": "posedge",
    "input_sampling": "immediately_before_active_edge",
    "registered_output_observation": "immediately_after_active_edge"
  },
  "reset": {
    "port": "rst",
    "type": "synchronous",
    "active_level": "high",
    "priority": "highest",
    "out_valid_after_reset": 0,
    "out_data_after_reset": 0
  },
  "parameters": {
    "DATA_WIDTH": {"type": "positive_integer", "default": 8},
    "DEPTH": {"type": "fixed_for_task", "value": 2}
  },
  "ports": {
    "in_valid": {"direction": "input", "width": 1},
    "in_ready": {"direction": "output", "width": 1},
    "in_data": {"direction": "input", "width": "DATA_WIDTH"},
    "out_valid": {"direction": "output", "width": 1},
    "out_ready": {"direction": "input", "width": 1},
    "out_data": {"direction": "output", "width": "DATA_WIDTH"}
  },
  "flag_semantics": {
    "out_valid": "current_occupancy_is_nonzero",
    "in_ready": "current_occupancy_is_less_than_2 || (out_valid && out_ready)",
    "out_data_when_empty": 0
  },
  "acceptance": {
    "input_transfer": "in_valid && in_ready",
    "output_transfer": "out_valid && out_ready",
    "simultaneous_when_full": "consume_oldest_and_accept_newest; occupancy_remains_2",
    "simultaneous_when_empty": "accept_input_only; no_combinational_read_through",
    "when_partial": "input_and_output_transfers_are_independent"
  },
  "read_data": {
    "definition": "out_data is the current oldest queued word when out_valid is high and zero otherwise",
    "no_bypass": true,
    "backpressure_stability": "out_valid and out_data remain unchanged while out_valid && !out_ready"
  },
  "ordering": "first_in_first_out"
}
