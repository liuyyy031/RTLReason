{
  "schema_version": "1.0",
  "task_id": "saturating_counter_v1",
  "module_name": "saturating_counter",
  "clock": {
    "port": "clk",
    "active_edge": "posedge",
    "input_sampling": "immediately_before_active_edge",
    "registered_output_observation": "immediately_after_active_edge"
  },
  "reset": {
    "port": "rst",
    "type": "synchronous",
    "active_level": "high",
    "priority": "highest",
    "count_after_reset": 0
  },
  "parameters": {
    "WIDTH": {"type": "positive_integer", "default": 8}
  },
  "ports": {
    "en": {"direction": "input", "width": 1},
    "up": {"direction": "input", "width": 1},
    "count": {"direction": "output", "width": "WIDTH"},
    "at_min": {"direction": "output", "width": 1},
    "at_max": {"direction": "output", "width": 1}
  },
  "acceptance": {
    "update": "en",
    "direction": "up=1 increments and up=0 decrements"
  },
  "transition": {
    "increment": "if count is below maximum, count becomes count+1; otherwise it holds",
    "decrement": "if count is above zero, count becomes count-1; otherwise it holds",
    "idle": "count holds"
  },
  "flag_semantics": {
    "at_min": "combinational current-state flag, count==0",
    "at_max": "combinational current-state flag, count==2**WIDTH-1"
  }
}
