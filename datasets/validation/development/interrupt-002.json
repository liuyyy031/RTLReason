    "rtl": {
      "language": "systemverilog",
      "module_name": "interrupt_pending",
      "code": "module interrupt_pending (\n  input clk,\n  input rst,\n  input [3:0] irq,\n  input [3:0] mask,\n  input ack,\n  output logic [3:0] pending,\n  output logic valid,\n  output logic [1:0] index\n);\n\n  logic [3:0] next_pending;\n  logic [3:0] ack_onehot;\n  logic [3:0] unmasked_irq;\n\n  assign unmasked_irq = irq & ~mask;\n\n  // priority encoder: lowest set bit\n  always_comb begin\n    valid = |pending;\n    index = 2'b00;\n    if (valid) begin\n      if (pending[0]) index = 2'b00;\n      else if (pending[1]) index = 2'b01;\n      else if (pending[2]) index = 2'b10;\n      else if (pending[3]) index = 2'b11;\n    end\n  end\n\n  // ack one-hot based on current pending\n  always_comb begin\n    ack_onehot = 4'b0;\n    if (ack && valid) begin\n      case (index)\n        2'b00: ack_onehot = 4'b0001;\n        2'b01: ack_onehot = 4'b0010;\n        2'b10: ack_onehot = 4'b0100;\n        2'b11: ack_onehot = 4'b1000;\n      endcase\n    end\n  end\n\n  // next pending\n  assign next_pending = (pending & ~ack_onehot) | unmasked_irq;\n\n  // sequential logic\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      pending <= 4'b0;\n    end else begin\n      pending <= next_pending;\n    end\n  end\n\nendmodule"
    },
    "metadata": {
      "notes": [
        "The architecture uses a single pending register and combinational logic for outputs and next state.",
        "Set-dominant behavior is achieved by ORing the unmasked irq after the clear term.",
        "All outputs are combinational from the pending register as per interface semantics."
