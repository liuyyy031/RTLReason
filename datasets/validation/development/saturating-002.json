    "rtl": {
      "language": "systemverilog",
      "module_name": "saturating_counter",
      "code": "module saturating_counter #(parameter WIDTH = 8) (\n  input  logic         clk,\n  input  logic         rst,\n  input  logic         en,\n  input  logic         up,\n  output logic [WIDTH-1:0] count,\n  output logic         at_min,\n  output logic         at_max\n);\n\n  logic [WIDTH-1:0] next_count;\n\n  always_comb begin\n    next_count = count;\n    if (en) begin\n      if (up) begin\n        if (count != {WIDTH{1'b1}})\n          next_count = count + 1'b1;\n      end else begin\n        if (count != {WIDTH{1'b0}})\n          next_count = count - 1'b1;\n      end\n    end\n  end\n\n  always_ff @(posedge clk) begin\n    if (rst)\n      count <= {WIDTH{1'b0}};\n    else\n      count <= next_count;\n  end\n\n  assign at_min = (count == {WIDTH{1'b0}});\n  assign at_max = (count == {WIDTH{1'b1}});\n\nendmodule"
    },
