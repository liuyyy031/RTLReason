    "rtl": {
      "language": "systemverilog",
      "module_name": "pulse_stretcher",
      "code": "module pulse_stretcher #(parameter int PULSE_CYCLES = 4) (\n  input  logic clk,\n  input  logic rst,\n  input  logic trigger,\n  output logic active\n);\n  localparam int CNT_WIDTH = (PULSE_CYCLES <= 1) ? 1 : $clog2(PULSE_CYCLES);\n  logic [CNT_WIDTH-1:0] cnt;\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      cnt    <= '0;\n      active <= 1'b0;\n    end else if (trigger) begin\n      cnt    <= PULSE_CYCLES - 1;\n      active <= 1'b1;\n    end else if (cnt > 0) begin\n      cnt    <= cnt - 1'b1;\n      active <= 1'b1;\n    end else begin\n      cnt    <= '0;\n      active <= 1'b0;\n    end\n  end\nendmodule"
    },
    "metadata": {
      "notes": [
        "Down-counter width uses $clog2; PULSE_CYCLES>=2 ensures correct load value. Reset priority handled by if-else ordering."
