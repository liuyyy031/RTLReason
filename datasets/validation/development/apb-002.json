    "rtl": {
      "language": "systemverilog",
      "module_name": "apb_register_bank",
      "code": "module apb_register_bank (\n  input  logic        clk,\n  input  logic        rst,\n  input  logic        psel,\n  input  logic        penable,\n  input  logic        pwrite,\n  input  logic [3:0]  paddr,\n  input  logic [31:0] pwdata,\n  output logic        pready,\n  output logic [31:0] prdata,\n  output logic        pslverr\n);\n\n  logic [31:0] reg0;\n  logic [31:0] reg1;\n\n  assign pready = 1'b1;\n\n  logic valid_addr;\n  assign valid_addr = (paddr == 4'h0) || (paddr == 4'h4);\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      reg0 <= 32'h0;\n      reg1 <= 32'h0;\n    end else if (psel && penable && pwrite) begin\n      if (paddr == 4'h0)      reg0 <= pwdata;\n      else if (paddr == 4'h4) reg1 <= pwdata;\n    end\n  end\n\n  assign prdata = (paddr == 4'h0) ? reg0 :\n                  (paddr == 4'h4) ? reg1 : 32'h0;\n\n  assign pslverr = (psel && penable && !valid_addr);\n\nendmodule"
    },
