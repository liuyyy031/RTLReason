    "rtl": {
      "language": "systemverilog",
      "module_name": "stream_width_adapter",
      "code": "module stream_width_adapter (\n    input  logic        clk,\n    input  logic        rst,\n    input  logic        in_valid,\n    output logic        in_ready,\n    input  logic [7:0]  in_data,\n    output logic        out_valid,\n    input  logic        out_ready,\n    output logic [15:0] out_data\n);\n\n    logic [7:0] stored_low;\n    logic       half;\n    logic       out_valid_reg;\n    logic [15:0] out_data_reg;\n\n    assign in_ready = !out_valid_reg;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            stored_low    <= 8'h00;\n            half          <= 1'b0;\n            out_valid_reg <= 1'b0;\n            out_data_reg  <= 16'h0000;\n        end else begin\n            if (out_valid_reg && out_ready) begin\n                out_valid_reg <= 1'b0;\n                half          <= 1'b0;\n            end else if (in_valid && in_ready) begin\n                if (!half) begin\n                    stored_low <= in_data;\n                    half       <= 1'b1;\n                end else begin\n                    out_data_reg  <= {in_data, stored_low};\n                    out_valid_reg <= 1'b1;\n                    half          <= 1'b0;\n                end\n            end\n        end\n    end\n\n    assign out_valid = out_valid_reg;\n    assign out_data  = out_data_reg;\n\nendmodule\n"
    },
    "metadata": {
      "notes": [
        "Combinational in_ready ensures no same-edge input during output valid; partial stored byte is not externally visible."
      ],
