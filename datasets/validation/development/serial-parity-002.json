    "rtl": {
      "language": "systemverilog",
      "module_name": "serial_parity",
      "code": "module serial_parity (\n  input  logic clk,\n  input  logic rst,\n  input  logic start,\n  input  logic bit_valid,\n  input  logic bit_in,\n  input  logic finish,\n  output logic busy,\n  output logic parity,\n  output logic done\n);\n\n  logic work_parity;\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      busy <= 1'b0;\n      work_parity <= 1'b0;\n      parity <= 1'b0;\n      done <= 1'b0;\n    end else begin\n      done <= 1'b0;\n      if (start && !busy) begin\n        busy <= 1'b1;\n        work_parity <= bit_valid ? bit_in : 1'b0;\n      end else if (finish && busy) begin\n        busy <= 1'b0;\n        work_parity <= work_parity ^ (bit_valid ? bit_in : 1'b0);\n        parity <= work_parity ^ (bit_valid ? bit_in : 1'b0);\n        done <= 1'b1;\n      end else if (busy && bit_valid) begin\n        busy <= 1'b1;\n        work_parity <= work_parity ^ bit_in;\n      end else begin\n        busy <= busy;\n        work_parity <= work_parity;\n      end\n    end\n  end\n\nendmodule\n"
