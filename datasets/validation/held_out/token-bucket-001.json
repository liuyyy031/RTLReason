    "rtl": {
      "language": "systemverilog",
      "module_name": "token_bucket",
      "code": "module token_bucket #(\n    parameter int CAPACITY = 3,\n    parameter int TOKEN_WIDTH = $clog2(CAPACITY+1)\n)(\n    input  logic clk,\n    input  logic rst,\n    input  logic req,\n    output logic grant,\n    output logic [TOKEN_WIDTH-1:0] tokens\n);\n\n    logic consume;\n    logic replenish;\n    logic [TOKEN_WIDTH-1:0] next_tokens;\n\n    always_comb begin\n        consume    = req && (tokens > 0);\n        replenish  = (tokens < CAPACITY);\n        next_tokens = tokens + replenish - consume;\n    end\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            tokens <= '0;\n            grant  <= 1'b0;\n        end else begin\n            tokens <= next_tokens;\n            grant  <= consume;\n        end\n    end\n\nendmodule"
    },
