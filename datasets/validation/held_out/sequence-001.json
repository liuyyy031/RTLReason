    "rtl": {
      "language": "systemverilog",
      "module_name": "sequence_detector_1011",
      "code": "module sequence_detector_1011 (\n  input  logic clk,\n  input  logic rst,\n  input  logic bit_valid,\n  input  logic bit_in,\n  output logic match\n);\n\n  typedef enum logic [1:0] {\n    S0 = 2'd0,\n    S1 = 2'd1,\n    S2 = 2'd2,\n    S3 = 2'd3\n  } state_t;\n\n  state_t state_reg, next_state;\n  logic   match_reg, next_match;\n\n  // Combinational next state and next match\n  always_comb begin\n    next_state = state_reg; // default hold (invalid cycle)\n    next_match = 1'b0;      // default no match (invalid clears)\n    if (bit_valid) begin\n      case (state_reg)\n        S0: next_state = bit_in ? S1 : S0;\n        S1: next_state = bit_in ? S1 : S2;\n        S2: next_state = bit_in ? S3 : S0;\n        S3: begin\n          if (bit_in) begin\n            next_state = S1; // overlap: final 1 starts new prefix\n            next_match = 1'b1;\n          end else begin\n            next_state = S2; // suffix 10\n          end\n        end\n        default: next_state = S0;\n      endcase\n    end\n  end\n\n  // Synchronous reset, registered update\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      state_reg <= S0;\n      match_reg <= 1'b0;\n    end else begin\n      state_reg <= next_state;\n      match_reg <= next_match;\n    end\n  end\n\n  assign match = match_reg;\n\nendmodule"
    },
