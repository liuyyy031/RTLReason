    "rtl": {
      "language": "systemverilog",
      "module_name": "interrupt_pending",
      "code": "module interrupt_pending (\n  input  logic        clk,\n  input  logic        rst,\n  input  logic [3:0]  irq,\n  input  logic [3:0]  mask,\n  input  logic        ack,\n  output logic [3:0]  pending,\n  output logic        valid,\n  output logic [1:0]  index\n);\n\n  logic [3:0] pending_reg;\n  logic [3:0] next_pending;\n  logic [3:0] ack_onehot;\n  logic [1:0] index_comb;\n  logic        valid_comb;\n\n  // priority encoder for lowest pending source\n  always_comb begin\n    if (pending_reg[0])      index_comb = 2'd0;\n    else if (pending_reg[1]) index_comb = 2'd1;\n    else if (pending_reg[2]) index_comb = 2'd2;\n    else if (pending_reg[3]) index_comb = 2'd3;\n    else                     index_comb = 2'd0;\n  end\n\n  assign valid_comb = |pending_reg;\n  assign ack_onehot = (ack && valid_comb) ? (4'b1 << index_comb) : 4'b0;\n\n  assign next_pending = (pending_reg & ~ack_onehot) | (irq & ~mask);\n\n  always_ff @(posedge clk) begin\n    if (rst) pending_reg <= 4'b0;\n    else     pending_reg <= next_pending;\n  end\n\n  assign pending = pending_reg;\n  assign valid   = valid_comb;\n  assign index   = index_comb;\n\nendmodule\n"
    },
