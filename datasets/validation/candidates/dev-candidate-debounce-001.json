    "rtl": {
      "language": "systemverilog",
      "module_name": "debounce_filter",
      "code": "module debounce_filter #(\n    parameter int STABLE_CYCLES = 3\n) (\n    input  logic clk,\n    input  logic rst,\n    input  logic noisy_in,\n    output logic debounced,\n    output logic changed\n);\n\n    logic [$clog2(STABLE_CYCLES+1)-1:0] cnt;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            debounced <= 1'b0;\n            changed   <= 1'b0;\n            cnt       <= '0;\n        end else begin\n            if (noisy_in == debounced) begin\n                cnt     <= '0;\n                changed <= 1'b0;\n            end else if (cnt == STABLE_CYCLES - 1'b1) begin\n                debounced <= noisy_in;\n                changed   <= 1'b1;\n                cnt       <= '0;\n            end else begin\n                cnt     <= cnt + 1'b1;\n                changed <= 1'b0;\n            end\n        end\n    end\n\nendmodule"
    },
    "metadata": {
      "notes": [
        "Counter width uses $clog2(STABLE_CYCLES+1); changed is a single-cycle pulse; synchronous reset has highest priority."
