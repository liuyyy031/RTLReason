    "rtl": {
      "language": "systemverilog",
      "module_name": "ready_valid_fifo2",
      "code": "module ready_valid_fifo2 #(parameter int DATA_WIDTH = 8) (\n    input  logic                 clk,\n    input  logic                 rst,\n    input  logic                 in_valid,\n    output logic                 in_ready,\n    input  logic [DATA_WIDTH-1:0] in_data,\n    output logic                 out_valid,\n    input  logic                 out_ready,\n    output logic [DATA_WIDTH-1:0] out_data\n);\n\n    logic [DATA_WIDTH-1:0] mem [0:1];\n    logic [1:0]            occ;\n\n    assign out_valid = (occ != 0);\n    assign in_ready  = (occ < 2) ? 1'b1 : out_ready;\n    assign out_data  = (occ != 0) ? mem[0] : {DATA_WIDTH{1'b0}};\n\n    logic in_xfer, out_xfer;\n    assign in_xfer  = in_valid && in_ready;\n    assign out_xfer = out_valid && out_ready;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            occ    <= 2'b0;\n            mem[0] <= {DATA_WIDTH{1'b0}};\n            mem[1] <= {DATA_WIDTH{1'b0}};\n        end else begin\n            if (in_xfer && !out_xfer) begin\n                if (occ == 2'b0) begin\n                    mem[0] <= in_data;\n                    occ    <= 2'b1;\n                end else if (occ == 2'b1) begin\n                    mem[1] <= in_data;\n                    occ    <= 2'b10;\n                end\n            end else if (!in_xfer && out_xfer) begin\n                if (occ == 2'b1) begin\n                    mem[0] <= {DATA_WIDTH{1'b0}};\n                    occ    <= 2'b0;\n                end else if (occ == 2'b10) begin\n                    mem[0] <= mem[1];\n                    mem[1] <= {DATA_WIDTH{1'b0}};\n                    occ    <= 2'b1;\n                end\n            end else if (in_xfer && out_xfer) begin\n                if (occ == 2'b1) begin\n                    mem[0] <= in_data;\n                    occ    <= 2'b1;\n                end else if (occ == 2'b10) begin\n                    mem[0] <= mem[1];\n                    mem[1] <= in_data;\n                    occ    <= 2'b10;\n                end\n            end\n        end\n    end\nendmodule"
    },
