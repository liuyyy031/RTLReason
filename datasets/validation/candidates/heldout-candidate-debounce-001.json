    "rtl": {
      "language": "systemverilog",
      "module_name": "debounce_filter",
      "code": "module debounce_filter #(\n    parameter int STABLE_CYCLES = 3\n) (\n    input  logic clk,\n    input  logic rst,\n    input  logic noisy_in,\n    output logic debounced,\n    output logic changed\n);\n\n    localparam int CNT_W = $clog2(STABLE_CYCLES);\n    localparam [CNT_W-1:0] THRESH = STABLE_CYCLES - 1;\n\n    logic [CNT_W-1:0] cnt;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            debounced <= 1'b0;\n            changed   <= 1'b0;\n            cnt       <= '0;\n        end else begin\n            changed <= 1'b0;\n            if (noisy_in == debounced) begin\n                cnt <= '0;\n            end else if (cnt == THRESH) begin\n                debounced <= noisy_in;\n                changed   <= 1'b1;\n                cnt       <= '0;\n            end else begin\n                cnt <= cnt + 1'b1;\n            end\n        end\n    end\n\nendmodule\n"
    },
    "metadata": {
      "notes": [
        "Counter width uses $clog2; STABLE_CYCLES>=2 ensures THRESH>=1.",
        "No CDC or metastability logic as per scope."
