    "rtl": {
      "language": "systemverilog",
      "module_name": "debounce_filter",
      "code": "module debounce_filter #(\n    parameter int STABLE_CYCLES = 3\n) (\n    input  logic clk,\n    input  logic rst,\n    input  logic noisy_in,\n    output logic debounced,\n    output logic changed\n);\n\n    localparam int CW = (STABLE_CYCLES <= 1) ? 1 : $clog2(STABLE_CYCLES);\n    logic [CW-1:0] counter;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            debounced <= 1'b0;\n            changed   <= 1'b0;\n            counter   <= '0;\n        end else begin\n            changed <= 1'b0;\n            if (noisy_in == debounced) begin\n                counter <= '0;\n            end else if (counter == STABLE_CYCLES - 1) begin\n                debounced <= noisy_in;\n                changed   <= 1'b1;\n                counter   <= '0;\n            end else begin\n                counter <= counter + 1'b1;\n            end\n        end\n    end\n\nendmodule"
    },
    "metadata": {
      "notes": [
