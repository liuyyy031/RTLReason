    "rtl": {
      "language": "systemverilog",
      "module_name": "sequence_detector_1011",
      "code": "module sequence_detector_1011 (\n  input  logic clk,\n  input  logic rst,\n  input  logic bit_valid,\n  input  logic bit_in,\n  output logic match\n);\n\n  // module_decl\n  // state encoding: 0=none,1='1',2='10',3='101'\n  logic [1:0] state_q;\n  logic [1:0] state_next;\n  logic       match_q;\n  logic       match_next;\n\n  // next_state_logic\n  always_comb begin : next_state_logic\n    state_next = state_q;\n    if (bit_valid) begin\n      case (state_q)\n        2'b00: state_next = bit_in ? 2'b01 : 2'b00;\n        2'b01: state_next = bit_in ? 2'b01 : 2'b10;\n        2'b10: state_next = bit_in ? 2'b11 : 2'b00;\n        2'b11: state_next = bit_in ? 2'b01 : 2'b10;\n        default: state_next = 2'b00;\n      endcase\n    end else begin\n      state_next = state_q;\n    end\n  end\n\n  // match_logic\n  always_comb begin : match_logic\n    if (bit_valid && state_q == 2'b11 && bit_in)\n      match_next = 1'b1;\n    else\n      match_next = 1'b0;\n  end\n\n  // seq_update (state_reg, match_reg)\n  always_ff @(posedge clk) begin : seq_update\n    if (rst) begin\n      state_q <= 2'b00;\n      match_q <= 1'b0;\n    end else begin\n      state_q <= state_next;\n      match_q <= match_next;\n    end\n  end\n\n  assign match = match_q;\n\nendmodule\n"
    },
