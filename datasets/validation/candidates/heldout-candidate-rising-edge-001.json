    "rtl": {
      "language": "systemverilog",
      "module_name": "rising_edge_detector",
      "code": "module rising_edge_detector (\n  input  logic clk,\n  input  logic rst,\n  input  logic signal_in,\n  output logic pulse\n);\n  logic prev_q;\n  logic pulse_q;\n  logic prev_d;\n  logic pulse_d;\n\n  assign prev_d = rst ? 1'b0 : signal_in;\n  assign pulse_d = rst ? 1'b0 : (signal_in & ~prev_q);\n\n  always_ff @(posedge clk) begin\n    prev_q <= prev_d;\n    pulse_q <= pulse_d;\n  end\n\n  assign pulse = pulse_q;\nendmodule"
    },
