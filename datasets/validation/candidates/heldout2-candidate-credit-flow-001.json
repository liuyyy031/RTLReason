    "rtl": {
      "language": "systemverilog",
      "module_name": "credit_flow_control",
      "code": "module credit_flow_control #(\n    parameter int MAX_CREDITS = 3\n) (\n    input  logic clk,\n    input  logic rst,\n    input  logic send_req,\n    input  logic credit_return,\n    output logic send_accept,\n    output logic [$clog2(MAX_CREDITS+1)-1:0] credits,\n    output logic empty,\n    output logic full\n);\n    localparam int CREDIT_WIDTH = $clog2(MAX_CREDITS + 1);\n    logic [CREDIT_WIDTH-1:0] cnt;\n\n    assign credits = cnt;\n    assign empty = (cnt == '0);\n    assign full = (cnt == MAX_CREDITS);\n    assign send_accept = !rst && send_req && (cnt != '0);\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            cnt <= CREDIT_WIDTH'(MAX_CREDITS);\n        end else begin\n            if (send_req && (cnt != '0)) begin\n                if (credit_return) begin\n                    cnt <= cnt;\n                end else begin\n                    cnt <= cnt - 1'b1;\n                end\n            end else begin\n                if (credit_return && (cnt < MAX_CREDITS)) begin\n                    cnt <= cnt + 1'b1;\n                end else begin\n                    cnt <= cnt;\n                end\n            end\n        end\n    end\nendmodule"
    },
