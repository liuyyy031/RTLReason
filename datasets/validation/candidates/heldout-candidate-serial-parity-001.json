    "rtl": {
      "language": "systemverilog",
      "module_name": "serial_parity",
      "code": "module serial_parity (\n  input  logic clk,\n  input  logic rst,\n  input  logic start,\n  input  logic bit_valid,\n  input  logic bit_in,\n  input  logic finish,\n  output logic busy,\n  output logic parity,\n  output logic done\n);\n\n  logic acc;\n\n  // block: seq_main\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      busy  <= 1'b0;\n      parity <= 1'b0;\n      done   <= 1'b0;\n      acc    <= 1'b0;\n    end else begin\n      done <= 1'b0; // default no pulse\n      if (start && !busy) begin\n        // accepted start\n        busy <= 1'b1;\n        acc  <= bit_valid ? bit_in : 1'b0;\n      end else if (busy && finish) begin\n        // accepted finish\n        busy <= 1'b0;\n        acc  <= acc ^ (bit_valid ? bit_in : 1'b0);\n        parity <= acc ^ (bit_valid ? bit_in : 1'b0);\n        done   <= 1'b1;\n      end else if (busy && bit_valid) begin\n        // normal active bit\n        acc <= acc ^ bit_in;\n      end\n      // else all registers hold\n    end\n  end\n\nendmodule\n"
    },
    "metadata": {
      "notes": [
        "Synchronous reset clears all state; done is default-low with one-cycle pulse on accepted finish."
