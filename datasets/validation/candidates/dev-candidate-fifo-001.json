    "rtl": {
      "language": "systemverilog",
      "module_name": "fifo_sync",
      "code": "module fifo_sync #(\n  parameter integer DATA_WIDTH = 8,\n  parameter integer DEPTH = 4\n) (\n  input  wire                  clk,\n  input  wire                  rst,\n  input  wire                  wr_en,\n  input  wire                  rd_en,\n  input  wire [DATA_WIDTH-1:0] din,\n  output reg  [DATA_WIDTH-1:0] dout,\n  output wire                  full,\n  output wire                  empty\n);\n\n  localparam integer AW = $clog2(DEPTH);\n  reg [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n  reg [AW-1:0]         wptr;\n  reg [AW-1:0]         rptr;\n  reg [AW:0]           occ;\n  logic                read_accept;\n  logic                write_accept;\n\n  assign full  = (occ == DEPTH);\n  assign empty = (occ == 0);\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      occ   <= 0;\n      wptr  <= 0;\n      rptr  <= 0;\n      dout  <= 0;\n    end else begin\n      read_accept  = rd_en && !empty;\n      write_accept = wr_en && (!full || read_accept);\n      if (write_accept) begin\n        mem[wptr] <= din;\n        if (wptr == DEPTH-1) wptr <= 0; else wptr <= wptr + 1;\n      end\n      if (read_accept) begin\n        dout <= mem[rptr];\n        if (rptr == DEPTH-1) rptr <= 0; else rptr <= rptr + 1;\n      end\n      occ <= occ + write_accept - read_accept;\n    end\n  end\nendmodule"
    },
    "metadata": {
      "notes": [
        "Chosen architecture uses occupancy counter to avoid pointer equality ambiguity and to simplify simultaneous R/W.",
        "DEPTH need not be power of two."
