    "rtl": {
      "language": "systemverilog",
      "module_name": "gray_code_counter",
      "code": "module gray_code_counter #(parameter int WIDTH = 4) (\n    input  logic clk,\n    input  logic rst,\n    input  logic en,\n    output logic [WIDTH-1:0] gray,\n    output logic wrap\n);\n    logic [WIDTH-1:0] idx;\n    logic [WIDTH-1:0] idx_next;\n    logic [WIDTH-1:0] gray_next;\n    logic wrap_next;\n\n    always_comb begin\n        idx_next = idx;\n        wrap_next = 1'b0;\n        if (en) begin\n            if (idx == (2**WIDTH - 1)) begin\n                idx_next = '0;\n                wrap_next = 1'b1;\n            end else begin\n                idx_next = idx + 1'b1;\n            end\n        end\n        gray_next = idx_next ^ (idx_next >> 1);\n    end\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            idx  <= '0;\n            gray <= '0;\n            wrap <= 1'b0;\n        end else begin\n            idx  <= idx_next;\n            gray <= gray_next;\n            wrap <= wrap_next;\n        end\n    end\nendmodule"
    },
    "metadata": {
      "notes": [
