    "rtl": {
      "language": "systemverilog",
      "module_name": "apb_register_bank",
      "code": "module apb_register_bank (\n  input  logic        clk,\n  input  logic        rst,\n  input  logic        psel,\n  input  logic        penable,\n  input  logic        pwrite,\n  input  logic [3:0]  paddr,\n  input  logic [31:0] pwdata,\n  output logic        pready,\n  output logic [31:0] prdata,\n  output logic        pslverr\n);\n\n  logic [31:0] reg0, reg1;\n  logic        addr0, addr4, valid_addr, transfer, write_en0, write_en1;\n\n  assign pready = 1'b1;\n\n  assign addr0 = (paddr == 4'h0);\n  assign addr4 = (paddr == 4'h4);\n  assign valid_addr = addr0 || addr4;\n  assign transfer = psel && penable && pready;\n\n  assign write_en0 = transfer && pwrite && addr0;\n  assign write_en1 = transfer && pwrite && addr4;\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      reg0 <= 32'h0;\n      reg1 <= 32'h0;\n    end else begin\n      if (write_en0) reg0 <= pwdata;\n      if (write_en1) reg1 <= pwdata;\n    end\n  end\n\n  assign prdata = addr0 ? reg0 : (addr4 ? reg1 : 32'h0);\n  assign pslverr = transfer && !valid_addr;\n\nendmodule\n"
    },
