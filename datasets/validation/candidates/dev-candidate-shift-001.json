    "rtl": {
      "language": "systemverilog",
      "module_name": "shift_register",
      "code": "module shift_register #(parameter int WIDTH = 8) (\n  input  logic        clk,\n  input  logic        rst,\n  input  logic        en,\n  input  logic        serial_in,\n  output logic [WIDTH-1:0] q,\n  output logic        serial_out\n);\n\n  logic [WIDTH-1:0] q_reg;\n\n  always_ff @(posedge clk) begin\n    if (rst)\n      q_reg <= '0;\n    else if (en)\n      q_reg <= {q_reg[WIDTH-2:0], serial_in};\n    else\n      q_reg <= q_reg;\n  end\n\n  assign q = q_reg;\n  assign serial_out = q_reg[WIDTH-1];\n\nendmodule\n"
    },
