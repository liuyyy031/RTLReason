    "rtl": {
      "language": "systemverilog",
      "module_name": "grant_hold_arbiter",
      "code": "module grant_hold_arbiter (\n  input  logic        clk,\n  input  logic        rst,\n  input  logic [3:0]  req,\n  input  logic        accept,\n  output logic [3:0]  grant\n);\n\n  logic [3:0] grant_next;\n\n  always_comb begin\n    if (grant == 4'b0000) begin\n      if (req[0])      grant_next = 4'b0001;\n      else if (req[1]) grant_next = 4'b0010;\n      else if (req[2]) grant_next = 4'b0100;\n      else if (req[3]) grant_next = 4'b1000;\n      else             grant_next = 4'b0000;\n    end else begin\n      if (accept) grant_next = 4'b0000;\n      else        grant_next = grant;\n    end\n  end\n\n  always_ff @(posedge clk) begin\n    if (rst) grant <= 4'b0000;\n    else     grant <= grant_next;\n  end\n\nendmodule"
    },
