    "rtl": {
      "language": "systemverilog",
      "module_name": "spi_tx",
      "code": "module spi_tx #(\n  parameter int HALF_PERIOD_CYCLES = 2\n) (\n  input  logic       clk,\n  input  logic       rst,\n  input  logic       start,\n  input  logic [7:0] data_in,\n  output logic       sclk,\n  output logic       mosi,\n  output logic       busy,\n  output logic       done\n);\n\n  logic [7:0]  shift;\n  logic [31:0] half_cnt;\n  logic [3:0]  rise_cnt;\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      busy     <= 1'b0;\n      sclk     <= 1'b0;\n      mosi     <= 1'b0;\n      done     <= 1'b0;\n      shift    <= 8'h00;\n      half_cnt <= 32'd0;\n      rise_cnt <= 4'd0;\n    end else begin\n      done <= 1'b0;\n\n      if (busy) begin\n        if (half_cnt == HALF_PERIOD_CYCLES - 1) begin\n          half_cnt <= 32'd0;\n          sclk     <= ~sclk;\n          if (!sclk) begin\n            rise_cnt <= rise_cnt + 4'd1;\n          end else begin\n            if (rise_cnt == 4'd8) begin\n              busy <= 1'b0;\n              sclk <= 1'b0;\n              mosi <= 1'b0;\n              done <= 1'b1;\n            end else begin\n              shift <= {shift[6:0], 1'b0};\n              mosi  <= shift[6];\n            end\n          end\n        end else begin\n          half_cnt <= half_cnt + 32'd1;\n        end\n      end else if (start) begin\n        busy     <= 1'b1;\n        sclk     <= 1'b0;\n        mosi     <= data_in[7];\n        shift    <= data_in;\n        half_cnt <= 32'd0;\n        rise_cnt <= 4'd0;\n      end else begin\n        busy <= 1'b0;\n        sclk <= 1'b0;\n        mosi <= 1'b0;\n      end\n    end\n  end\n\nendmodule\n"
    },
