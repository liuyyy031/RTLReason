    "rtl": {
      "language": "systemverilog",
      "module_name": "async_handshake",
      "code": "module async_handshake (\n  input  wire src_clk,\n  input  wire src_rst,\n  input  wire src_send,\n  output wire src_accept,\n  output wire src_busy,\n  input  wire dst_clk,\n  input  wire dst_rst,\n  output wire dst_pulse\n);\n\n  reg req_toggle;\n  reg ack_sync_src1;\n  reg ack_sync_src2;\n  reg req_sync_dst1;\n  reg req_sync_dst2;\n  reg ack_toggle_dst;\n  reg dst_pulse_reg;\n\n  assign src_busy = (req_toggle != ack_sync_src2);\n  assign src_accept = (!src_rst && src_send && !src_busy);\n  assign dst_pulse = dst_pulse_reg;\n\n  // Source domain: request toggle and acknowledgement synchronizer\n  always @(posedge src_clk) begin\n    if (src_rst) begin\n      req_toggle <= 1'b0;\n      ack_sync_src1 <= 1'b0;\n      ack_sync_src2 <= 1'b0;\n    end else begin\n      ack_sync_src1 <= ack_toggle_dst;\n      ack_sync_src2 <= ack_sync_src1;\n      if (src_accept) req_toggle <= ~req_toggle;\n    end\n  end\n\n  // Destination domain: two-stage request synchronizer\n  always @(posedge dst_clk) begin\n    if (dst_rst) begin\n      req_sync_dst1 <= 1'b0;\n      req_sync_dst2 <= 1'b0;\n    end else begin\n      req_sync_dst1 <= req_toggle;\n      req_sync_dst2 <= req_sync_dst1;\n    end\n  end\n\n  // Destination domain: change detection and one-cycle pulse\n  always @(posedge dst_clk) begin\n    if (dst_rst) begin\n      ack_toggle_dst <= 1'b0;\n      dst_pulse_reg <= 1'b0;\n    end else if (req_sync_dst2 != ack_toggle_dst) begin\n      ack_toggle_dst <= req_sync_dst2;\n      dst_pulse_reg <= 1'b1;\n    end else begin\n      dst_pulse_reg <= 1'b0;\n    end\n  end\n\nendmodule\n"
    },
