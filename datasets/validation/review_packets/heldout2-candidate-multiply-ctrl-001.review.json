    "rtl": {
      "language": "systemverilog",
      "module_name": "multicycle_multiply_ctrl",
      "code": "module multicycle_multiply_ctrl #(\n  parameter int WIDTH = 8\n) (\n  input  logic                  clk,\n  input  logic                  rst,\n  input  logic                  start,\n  input  logic [WIDTH-1:0]      a,\n  input  logic [WIDTH-1:0]      b,\n  output logic                  busy,\n  output logic                  done,\n  output logic [2*WIDTH-1:0]    result\n);\n\n  localparam int AW    = 2*WIDTH;\n  localparam int CNT_W = $clog2(WIDTH + 1);\n\n  logic                  busy_r;\n  logic                  done_r;\n  logic [AW-1:0]         result_r;\n  logic [AW-1:0]         acc_r;\n  logic [AW-1:0]         mcand_r;\n  logic [WIDTH-1:0]      mplier_r;\n  logic [CNT_W-1:0]      cnt_r;\n\n  logic [AW-1:0]         next_acc;\n  logic [AW-1:0]         next_mcand;\n  logic [WIDTH-1:0]      next_mplier;\n\n  assign next_acc    = mplier_r[0] ? (acc_r + mcand_r) : acc_r;\n  assign next_mcand  = mcand_r << 1;\n  assign next_mplier = mplier_r >> 1;\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      busy_r   <= 1'b0;\n      done_r   <= 1'b0;\n      result_r <= '0;\n      acc_r    <= '0;\n      mcand_r  <= '0;\n      mplier_r <= '0;\n      cnt_r    <= '0;\n    end else if (!busy_r && start) begin\n      busy_r   <= 1'b1;\n      mcand_r  <= {{(WIDTH){1'b0}}, a};\n      mplier_r <= b;\n      acc_r    <= '0;\n      cnt_r    <= '0;\n      done_r   <= 1'b0;\n    end else if (busy_r) begin\n      acc_r    <= next_acc;\n      mcand_r  <= next_mcand;\n      mplier_r <= next_mplier;\n      if (cnt_r == WIDTH - 1) begin\n        result_r <= next_acc;\n        busy_r   <= 1'b0;\n        done_r   <= 1'b1;\n        cnt_r    <= '0;\n      end else begin\n        cnt_r  <= cnt_r + 1'b1;\n        done_r <= 1'b0;\n      end\n    end else begin\n      done_r <= 1'b0;\n    end\n  end\n\n  assign busy   = busy_r;\n  assign done   = done_r;\n  assign result = result_r;\n\nendmodule\n"
    },
