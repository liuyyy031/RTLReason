    "rtl": {
      "language": "systemverilog",
      "module_name": "axi_stream_packet_counter",
      "code": "module axi_stream_packet_counter #(parameter int COUNT_WIDTH = 8) (\n  input  logic clk,\n  input  logic rst,\n  input  logic clear,\n  input  logic tvalid,\n  input  logic tready,\n  input  logic tlast,\n  output logic [COUNT_WIDTH-1:0] beat_count,\n  output logic [COUNT_WIDTH-1:0] packet_count\n);\n\n  localparam [COUNT_WIDTH-1:0] MAX = {COUNT_WIDTH{1'b1}};\n  logic [COUNT_WIDTH-1:0] beat_cnt_r;\n  logic [COUNT_WIDTH-1:0] packet_cnt_r;\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      beat_cnt_r   <= '0;\n      packet_cnt_r <= '0;\n    end else if (clear) begin\n      beat_cnt_r   <= '0;\n      packet_cnt_r <= '0;\n    end else if (tvalid && tready) begin\n      beat_cnt_r <= (beat_cnt_r == MAX) ? MAX : beat_cnt_r + 1'b1;\n      if (tlast)\n        packet_cnt_r <= (packet_cnt_r == MAX) ? MAX : packet_cnt_r + 1'b1;\n      else\n        packet_cnt_r <= packet_cnt_r;\n    end else begin\n      beat_cnt_r   <= beat_cnt_r;\n      packet_cnt_r <= packet_cnt_r;\n    end\n  end\n\n  assign beat_count   = beat_cnt_r;\n  assign packet_count = packet_cnt_r;\n\nendmodule"
    },
