    "rtl": {
      "language": "systemverilog",
      "module_name": "request_ack_timeout",
      "code": "module request_ack_timeout #(\n    parameter int TIMEOUT_CYCLES = 4\n) (\n    input  logic clk,\n    input  logic rst,\n    input  logic req,\n    input  logic ack,\n    output logic busy,\n    output logic done,\n    output logic timeout\n);\n\n    localparam int CW = (TIMEOUT_CYCLES >= 2) ? $clog2(TIMEOUT_CYCLES+1) : 1;\n    logic [CW-1:0] cnt_reg;\n    logic          busy_reg;\n    logic          done_reg;\n    logic          timeout_reg;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            busy_reg    <= 1'b0;\n            done_reg    <= 1'b0;\n            timeout_reg <= 1'b0;\n            cnt_reg     <= '0;\n        end else begin\n            done_reg    <= 1'b0;\n            timeout_reg <= 1'b0;\n            if (!busy_reg) begin\n                if (req) begin\n                    busy_reg <= 1'b1;\n                    cnt_reg  <= TIMEOUT_CYCLES;\n                end else begin\n                    busy_reg <= 1'b0;\n                end\n            end else begin\n                if (ack) begin\n                    busy_reg <= 1'b0;\n                    done_reg <= 1'b1;\n                end else if (cnt_reg == 1) begin\n                    busy_reg    <= 1'b0;\n                    timeout_reg <= 1'b1;\n                end else begin\n                    cnt_reg <= cnt_reg - 1'b1;\n                    busy_reg <= 1'b1;\n                end\n            end\n        end\n    end\n\n    assign busy    = busy_reg;\n    assign done    = done_reg;\n    assign timeout = timeout_reg;\n\nendmodule"
    },
