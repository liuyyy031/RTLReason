    "rtl": {
      "language": "systemverilog",
      "module_name": "apb_register_bank",
      "code": "module apb_register_bank (\n  input  logic        clk,\n  input  logic        rst,\n  input  logic        psel,\n  input  logic        penable,\n  input  logic        pwrite,\n  input  logic [3:0]  paddr,\n  input  logic [31:0] pwdata,\n  output logic        pready,\n  output logic [31:0] prdata,\n  output logic        pslverr\n);\n\n  logic [31:0] reg0, reg1;\n  logic        sel0, sel1, valid_addr, invalid_addr;\n  logic        transfer, wen, wen0, wen1;\n\n  // Address decode (combinational)\n  assign sel0 = (paddr == 4'h0);\n  assign sel1 = (paddr == 4'h4);\n  assign valid_addr = sel0 || sel1;\n  assign invalid_addr = ~valid_addr;\n\n  // Transfer and write enables (combinational)\n  assign transfer = psel && penable; // pready always 1\n  assign wen = transfer && pwrite && valid_addr;\n  assign wen0 = wen && sel0;\n  assign wen1 = wen && sel1;\n\n  // Outputs (combinational)\n  assign pready = 1'b1;\n  assign prdata = sel0 ? reg0 : (sel1 ? reg1 : 32'b0);\n  assign pslverr = transfer && invalid_addr;\n\n  // Sequential state update with synchronous reset\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      reg0 <= 32'b0;\n      reg1 <= 32'b0;\n    end else begin\n      if (wen0) reg0 <= pwdata;\n      if (wen1) reg1 <= pwdata;\n    end\n  end\n\nendmodule\n"
    },
