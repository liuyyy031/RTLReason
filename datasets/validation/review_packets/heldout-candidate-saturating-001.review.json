    "rtl": {
      "language": "systemverilog",
      "module_name": "saturating_counter",
      "code": "module saturating_counter #(parameter WIDTH = 8) (\n    input logic clk,\n    input logic rst,\n    input logic en,\n    input logic up,\n    output logic [WIDTH-1:0] count,\n    output logic at_min,\n    output logic at_max\n);\n    localparam [WIDTH-1:0] MAX = (2**WIDTH)-1;\n    logic [WIDTH-1:0] count_r;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            count_r <= '0;\n        end else if (en) begin\n            if (up) begin\n                if (count_r < MAX) count_r <= count_r + 1'b1;\n            end else begin\n                if (count_r > 0) count_r <= count_r - 1'b1;\n            end\n        end\n    end\n\n    assign count = count_r;\n    assign at_min = (count_r == '0);\n    assign at_max = (count_r == MAX);\nendmodule"
    },
