      "language": "systemverilog",
      "module_name": "register_file_bypass",
      "code": "module register_file_bypass #(parameter int DATA_WIDTH = 8, parameter int ADDR_WIDTH = 2) (input logic clk, input logic rst, input logic we, input logic [ADDR_WIDTH-1:0] waddr, input logic [DATA_WIDTH-1:0] wdata, input logic [ADDR_WIDTH-1:0] raddr_a, input logic [ADDR_WIDTH-1:0] raddr_b, output logic [DATA_WIDTH-1:0] rdata_a, output logic [DATA_WIDTH-1:0] rdata_b);\n  localparam int DEPTH = 2**ADDR_WIDTH;\n  logic [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      for (int i = 0; i < DEPTH; i++) mem[i] <= '0;\n    end else if (we) begin\n      mem[waddr] <= wdata;\n    end\n  end\n  assign rdata_a = (rst == 1'b0 && we == 1'b1 && raddr_a == waddr) ? wdata : mem[raddr_a];\n  assign rdata_b = (rst == 1'b0 && we == 1'b1 && raddr_b == waddr) ? wdata : mem[raddr_b];\nendmodule"
    },
