      "language": "systemverilog",
      "module_name": "rising_edge_detector",
      "code": "module rising_edge_detector (\n    input  logic clk,\n    input  logic rst,\n    input  logic signal_in,\n    output logic pulse\n);\n\n    logic prev_sample;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            pulse       <= 1'b0;\n            prev_sample <= 1'b0;\n        end else begin\n            prev_sample <= signal_in;\n            pulse       <= signal_in & ~prev_sample;\n        end\n    end\n\nendmodule"
    },
