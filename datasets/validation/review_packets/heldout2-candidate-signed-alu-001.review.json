    "rtl": {
      "language": "systemverilog",
      "module_name": "signed_alu_flags",
      "code": "module signed_alu_flags #(parameter int WIDTH = 8) (\n    input  logic [WIDTH-1:0] a,\n    input  logic [WIDTH-1:0] b,\n    input  logic [1:0]       op,\n    output logic [WIDTH-1:0] result,\n    output logic             zero,\n    output logic             negative,\n    output logic             carry,\n    output logic             overflow\n);\n    logic [WIDTH:0] ext_add;\n    logic [WIDTH:0] ext_sub;\n    logic [WIDTH-1:0] add_res, sub_res, and_res, xor_res;\n    logic             carry_add, carry_sub;\n    logic             ovf_add, ovf_sub;\n    logic [WIDTH-1:0] arith_res;\n    logic             arith_carry, arith_ovf;\n\n    assign ext_add = {1'b0, a} + {1'b0, b};\n    assign ext_sub = {1'b0, a} - {1'b0, b};\n    assign add_res = ext_add[WIDTH-1:0];\n    assign sub_res = ext_sub[WIDTH-1:0];\n    assign carry_add = ext_add[WIDTH];\n    assign carry_sub = ~ext_sub[WIDTH];\n    assign and_res = a & b;\n    assign xor_res = a ^ b;\n    assign ovf_add = (a[WIDTH-1] == b[WIDTH-1]) && (add_res[WIDTH-1] != a[WIDTH-1]);\n    assign ovf_sub = (a[WIDTH-1] != b[WIDTH-1]) && (sub_res[WIDTH-1] != a[WIDTH-1]);\n\n    always_comb begin\n        case (op)\n            2'b00: begin arith_res = add_res; arith_carry = carry_add; arith_ovf = ovf_add; end\n            2'b01: begin arith_res = sub_res; arith_carry = carry_sub; arith_ovf = ovf_sub; end\n            2'b10: begin arith_res = and_res; arith_carry = 1'b0; arith_ovf = 1'b0; end\n            2'b11: begin arith_res = xor_res; arith_carry = 1'b0; arith_ovf = 1'b0; end\n            default: begin arith_res = '0; arith_carry = 1'b0; arith_ovf = 1'b0; end\n        endcase\n    end\n\n    assign result = arith_res;\n    assign zero = (arith_res == '0);\n    assign negative = arith_res[WIDTH-1];\n    assign carry = arith_carry;\n    assign overflow = arith_ovf;\nendmodule"
    },
