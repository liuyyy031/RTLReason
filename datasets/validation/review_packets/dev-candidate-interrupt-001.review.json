    "rtl": {
      "language": "systemverilog",
      "module_name": "interrupt_pending",
      "code": "module interrupt_pending (\n  input  logic        clk,\n  input  logic        rst,\n  input  logic [3:0]  irq,\n  input  logic [3:0]  mask,\n  input  logic        ack,\n  output logic [3:0]  pending,\n  output logic        valid,\n  output logic [1:0]  index\n);\n\n  logic [3:0] pending_reg;\n  logic [3:0] ack_onehot;\n  logic [3:0] next_pending;\n\n  // priority encoder: lowest-numbered pending source\n  always_comb begin\n    valid = 1'b0;\n    index = 2'b00;\n    if (pending_reg[0]) begin\n      valid = 1'b1;\n      index = 2'b00;\n    end else if (pending_reg[1]) begin\n      valid = 1'b1;\n      index = 2'b01;\n    end else if (pending_reg[2]) begin\n      valid = 1'b1;\n      index = 2'b10;\n    end else if (pending_reg[3]) begin\n      valid = 1'b1;\n      index = 2'b11;\n    end else begin\n      valid = 1'b0;\n      index = 2'b00;\n    end\n  end\n\n  // ack one-hot mask\n  always_comb begin\n    if (ack && valid)\n      ack_onehot = (4'b0001 << index);\n    else\n      ack_onehot = 4'b0000;\n  end\n\n  // next pending computation\n  always_comb begin\n    next_pending = (pending_reg & ~ack_onehot) | (irq & ~mask);\n  end\n\n  // synchronous update\n  always_ff @(posedge clk) begin\n    if (rst)\n      pending_reg <= 4'b0000;\n    else\n      pending_reg <= next_pending;\n  end\n\n  assign pending = pending_reg;\n\nendmodule\n"
    },
