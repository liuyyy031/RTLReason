    "rtl": {
      "language": "systemverilog",
      "module_name": "ready_valid_fifo2",
      "code": "module ready_valid_fifo2 #(parameter DATA_WIDTH = 8) (\n  input  logic                   clk,\n  input  logic                   rst,\n  input  logic                   in_valid,\n  output logic                   in_ready,\n  input  logic [DATA_WIDTH-1:0]  in_data,\n  output logic                   out_valid,\n  input  logic                   out_ready,\n  output logic [DATA_WIDTH-1:0]  out_data\n);\n\n  logic [1:0] occ;\n  logic [DATA_WIDTH-1:0] mem0, mem1;\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      occ  <= 2'd0;\n      mem0 <= {DATA_WIDTH{1'b0}};\n      mem1 <= {DATA_WIDTH{1'b0}};\n    end else begin\n      case (occ)\n        2'd0: if (in_valid) begin\n                mem0 <= in_data;\n                occ  <= 2'd1;\n              end\n        2'd1: begin\n                if (in_valid && !out_ready) begin\n                  mem1 <= in_data;\n                  occ  <= 2'd2;\n                end else if (!in_valid && out_ready) begin\n                  occ  <= 2'd0;\n                end else if (in_valid && out_ready) begin\n                  mem0 <= in_data;\n                  occ  <= 2'd1;\n                end\n              end\n        2'd2: begin\n                if (out_ready && !in_valid) begin\n                  mem0 <= mem1;\n                  occ  <= 2'd1;\n                end else if (out_ready && in_valid) begin\n                  mem0 <= mem1;\n                  mem1 <= in_data;\n                  occ  <= 2'd2;\n                end\n              end\n      endcase\n    end\n  end\n\n  assign out_valid = (occ != 2'd0);\n  assign in_ready  = (occ < 2'd2) || (out_valid && out_ready);\n  assign out_data  = out_valid ? mem0 : {DATA_WIDTH{1'b0}};\n\nendmodule"
    },
