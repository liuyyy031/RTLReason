    "rtl": {
      "language": "systemverilog",
      "module_name": "round_robin_arbiter",
      "code": "module round_robin_arbiter (\n    input  logic        clk,\n    input  logic        rst,\n    input  logic [3:0]  req,\n    output logic [3:0]  grant\n);\n\n    logic [1:0] ptr_q;\n    logic [3:0] grant_q;\n    logic [3:0] req_rot;\n    logic [1:0] enc;\n    logic       valid;\n    logic [1:0] gidx;\n    logic [1:0] ptr_d;\n\n    // Combinational rotate and priority\n    always_comb begin\n        req_rot = (req >> ptr_q) | (req << (4 - ptr_q));\n        if (req_rot[0])      {valid, enc} = {1'b1, 2'd0};\n        else if (req_rot[1]) {valid, enc} = {1'b1, 2'd1};\n        else if (req_rot[2]) {valid, enc} = {1'b1, 2'd2};\n        else if (req_rot[3]) {valid, enc} = {1'b1, 2'd3};\n        else                 {valid, enc} = {1'b0, 2'd0};\n\n        gidx = (ptr_q + enc) & 2'd3; // mod 4\n        ptr_d = valid ? (gidx + 2'd1) & 2'd3 : ptr_q;\n    end\n\n    // Sequential update\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            grant_q <= 4'b0;\n            ptr_q   <= 2'd0;\n        end else begin\n            grant_q <= valid ? (4'b1 << gidx) : 4'b0;\n            ptr_q   <= ptr_d;\n        end\n    end\n\n    assign grant = grant_q;\n\nendmodule"
    },
