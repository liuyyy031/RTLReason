    "rtl": {
      "language": "systemverilog",
      "module_name": "grant_hold_arbiter",
      "code": "module grant_hold_arbiter (\n    input  logic        clk,\n    input  logic        rst,\n    input  logic [3:0]  req,\n    input  logic        accept,\n    output logic [3:0]  grant\n);\n\n    logic [3:0] grant_reg;\n    logic [3:0] grant_next;\n\n    // Combinational next-state logic\n    always_comb begin\n        if (rst) begin\n            grant_next = 4'b0000;\n        end else if (grant_reg != 4'b0000) begin\n            if (accept)\n                grant_next = 4'b0000;\n            else\n                grant_next = grant_reg;\n        end else begin\n            // idle: priority encoder lowest index\n            case (1'b1)\n                req[0]: grant_next = 4'b0001;\n                req[1]: grant_next = 4'b0010;\n                req[2]: grant_next = 4'b0100;\n                req[3]: grant_next = 4'b1000;\n                default: grant_next = 4'b0000;\n            endcase\n        end\n    end\n\n    // Sequential register\n    always_ff @(posedge clk) begin\n        grant_reg <= grant_next;\n    end\n\n    assign grant = grant_reg;\n\nendmodule"
    },
