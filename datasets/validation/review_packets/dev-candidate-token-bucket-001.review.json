      "language": "systemverilog",
      "module_name": "token_bucket",
      "code": "module token_bucket #(parameter int CAPACITY = 3, parameter int TOKEN_WIDTH = $clog2(CAPACITY+1)) (\n  input  logic clk,\n  input  logic rst,\n  input  logic req,\n  output logic grant,\n  output logic [TOKEN_WIDTH-1:0] tokens\n);\n  logic replenish;\n  logic accept;\n  logic [TOKEN_WIDTH-1:0] tokens_next;\n\n  always_comb begin\n    replenish = (tokens < CAPACITY);\n    accept = req && (tokens > 0);\n    tokens_next = tokens + replenish - accept;\n  end\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      tokens <= '0;\n      grant <= 1'b0;\n    end else begin\n      tokens <= tokens_next;\n      grant <= accept;\n    end\n  end\nendmodule\n"
    },
