    "rtl": {
      "language": "systemverilog",
      "module_name": "apb_register_bank",
      "code": "module apb_register_bank (\n  input  logic        clk,\n  input  logic        rst,\n  input  logic        psel,\n  input  logic        penable,\n  input  logic        pwrite,\n  input  logic [3:0]  paddr,\n  input  logic [31:0] pwdata,\n  output logic        pready,\n  output logic [31:0] prdata,\n  output logic        pslverr\n);\n\n  logic [31:0] reg0, reg1;\n\n  logic addr0, addr4, valid_addr;\n  logic transfer, do_write, do_invalid;\n\n  // decode\n  assign addr0 = (paddr == 4'b0000);\n  assign addr4 = (paddr == 4'b0100);\n  assign valid_addr = addr0 | addr4;\n  assign transfer = psel & penable; // pready always 1\n  assign do_write = transfer & pwrite & valid_addr;\n  assign do_invalid = transfer & ~valid_addr;\n\n  // outputs\n  assign pready = 1'b1;\n  assign prdata = addr0 ? reg0 : (addr4 ? reg1 : 32'b0);\n  assign pslverr = do_invalid;\n\n  // registers\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      reg0 <= 32'b0;\n      reg1 <= 32'b0;\n    end else if (do_write) begin\n      if (addr0) reg0 <= pwdata;\n      if (addr4) reg1 <= pwdata;\n    end\n  end\n\nendmodule\n"
    },
