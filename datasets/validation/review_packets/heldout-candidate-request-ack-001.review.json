    "rtl": {
      "language": "systemverilog",
      "module_name": "request_ack_timeout",
      "code": "module request_ack_timeout #(\n    parameter int TIMEOUT_CYCLES = 4\n) (\n    input  logic clk,\n    input  logic rst,\n    input  logic req,\n    input  logic ack,\n    output logic busy,\n    output logic done,\n    output logic timeout\n);\n\n    typedef enum logic {IDLE, BUSY} state_t;\n    state_t state, next_state;\n    logic [31:0] cnt, next_cnt;\n    logic next_busy, next_done, next_timeout;\n\n    always_comb begin\n        next_state = state;\n        next_cnt = cnt;\n        next_busy = 1'b0;\n        next_done = 1'b0;\n        next_timeout = 1'b0;\n        case (state)\n            IDLE: begin\n                next_busy = 1'b0;\n                if (req) begin\n                    next_state = BUSY;\n                    next_cnt = TIMEOUT_CYCLES;\n                    next_busy = 1'b1;\n                end\n            end\n            BUSY: begin\n                next_busy = 1'b1;\n                if (ack) begin\n                    next_state = IDLE;\n                    next_busy = 1'b0;\n                    next_done = 1'b1;\n                end else if (cnt == 32'd1) begin\n                    next_state = IDLE;\n                    next_busy = 1'b0;\n                    next_timeout = 1'b1;\n                end else begin\n                    next_cnt = cnt - 32'd1;\n                end\n            end\n        endcase\n    end\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            state <= IDLE;\n            cnt <= 32'd0;\n            busy <= 1'b0;\n            done <= 1'b0;\n            timeout <= 1'b0;\n        end else begin\n            state <= next_state;\n            cnt <= next_cnt;\n            busy <= next_busy;\n            done <= next_done;\n            timeout <= next_timeout;\n        end\n    end\n\nendmodule"
    },
    "metadata": {
      "notes": [
        "Counter width fixed 32 bits for simplicity; synthesis will optimize. Ack priority encoded by checking ack before cnt==1. Request while busy ignored by only acting on req in IDLE state."
