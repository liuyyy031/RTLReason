    "rtl": {
      "language": "systemverilog",
      "module_name": "counter_enable",
      "code": "module counter_enable #(parameter WIDTH = 8) (\n  input  logic         clk,\n  input  logic         rst,\n  input  logic         en,\n  input  logic         load,\n  input  logic [WIDTH-1:0] load_value,\n  output logic [WIDTH-1:0] count,\n  output logic         overflow\n);\n\n  logic [WIDTH-1:0] next_count;\n  logic             next_overflow;\n\n  always_comb begin\n    next_count   = count;\n    next_overflow = 1'b0;\n    if (rst) begin\n      next_count   = '0;\n      next_overflow = 1'b0;\n    end else if (load) begin\n      next_count   = load_value;\n      next_overflow = 1'b0;\n    end else if (en) begin\n      next_count   = count + 1'b1;\n      if (count == {(WIDTH){1'b1}})\n        next_overflow = 1'b1;\n      else\n        next_overflow = 1'b0;\n    end else begin\n      next_count   = count;\n      next_overflow = 1'b0;\n    end\n  end\n\n  always_ff @(posedge clk) begin\n    count    <= next_count;\n    overflow <= next_overflow;\n  end\nendmodule"
    },
