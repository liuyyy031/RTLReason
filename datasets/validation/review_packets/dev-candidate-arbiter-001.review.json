    "rtl": {
      "language": "systemverilog",
      "module_name": "round_robin_arbiter",
      "code": "module round_robin_arbiter (\n    input  logic        clk,\n    input  logic        rst,\n    input  logic [3:0]  req,\n    output logic [3:0]  grant\n);\n\n    logic [1:0] ptr;\n    logic [1:0] ptr_next;\n    logic [3:0] grant_next;\n    logic [3:0] req_rot;\n    logic [1:0] first_idx;\n    logic       found;\n\n    // Rotate req by ptr so scan starts at ptr\n    always_comb begin\n        req_rot = 4'b0;\n        for (int i=0; i<4; i++) begin\n            req_rot[i] = req[(ptr + i) % 4];\n        end\n    end\n\n    // Find first asserted in req_rot\n    always_comb begin\n        found = 1'b0;\n        first_idx = 2'd0;\n        for (int i=0; i<4; i++) begin\n            if (!found && req_rot[i]) begin\n                found = 1'b1;\n                first_idx = 2'(i);\n            end\n        end\n    end\n\n    // Next grant and ptr\n    always_comb begin\n        grant_next = 4'b0;\n        ptr_next = ptr;\n        if (found) begin\n            logic [1:0] winner;\n            winner = (ptr + first_idx) % 4;\n            grant_next = 4'b1 << winner;\n            ptr_next = (winner + 1) % 4;\n        end else begin\n            grant_next = 4'b0;\n            ptr_next = ptr;\n        end\n    end\n\n    // Synchronous reset and register update\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            grant <= 4'b0;\n            ptr <= 2'd0;\n        end else begin\n            grant <= grant_next;\n            ptr <= ptr_next;\n        end\n    end\n\nendmodule\n"
    },
