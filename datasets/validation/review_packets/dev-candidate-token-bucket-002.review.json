    "rtl": {
      "language": "systemverilog",
      "module_name": "token_bucket",
      "code": "module token_bucket #(\n    parameter int CAPACITY = 3\n) (\n    input  logic clk,\n    input  logic rst,\n    input  logic req,\n    output logic grant,\n    output logic [$clog2(CAPACITY+1)-1:0] tokens\n);\n    localparam int TOKEN_WIDTH = $clog2(CAPACITY+1);\n    logic [TOKEN_WIDTH-1:0] cnt;\n    logic [TOKEN_WIDTH-1:0] next_cnt;\n    logic consume;\n\n    always_comb begin\n        logic replenish;\n        replenish = (cnt < CAPACITY) ? 1'b1 : 1'b0;\n        consume = req && (cnt > '0);\n        next_cnt = cnt + TOKEN_WIDTH'(replenish) - TOKEN_WIDTH'(consume);\n    end\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            cnt <= '0;\n            grant <= 1'b0;\n        end else begin\n            cnt <= next_cnt;\n            grant <= consume;\n        end\n    end\n\n    assign tokens = cnt;\nendmodule\n"
    },
