    "rtl": {
      "language": "systemverilog",
      "module_name": "stream_width_adapter",
      "code": "module stream_width_adapter (\n  input  logic        clk,\n  input  logic        rst,\n  input  logic        in_valid,\n  output logic        in_ready,\n  input  logic [7:0]  in_data,\n  output logic        out_valid,\n  input  logic        out_ready,\n  output logic [15:0] out_data\n);\n\n  logic [7:0] low_byte;\n  logic       have_low;\n\n  assign in_ready = !out_valid;\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      out_valid <= 1'b0;\n      out_data  <= 16'h0000;\n      low_byte  <= 8'h00;\n      have_low  <= 1'b0;\n    end else begin\n      if (in_valid && in_ready) begin\n        if (!have_low) begin\n          low_byte <= in_data;\n          have_low <= 1'b1;\n        end else begin\n          out_data <= {in_data, low_byte};\n          out_valid <= 1'b1;\n          have_low <= 1'b0;\n        end\n      end\n      if (out_valid && out_ready) begin\n        out_valid <= 1'b0;\n      end\n    end\n  end\nendmodule\n"
    },
