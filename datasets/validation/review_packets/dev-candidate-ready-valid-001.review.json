    "rtl": {
      "language": "systemverilog",
      "module_name": "ready_valid_slice",
      "code": "module ready_valid_slice #(parameter int DATA_WIDTH = 8) (\n    input  logic                   clk,\n    input  logic                   rst,\n    input  logic                   in_valid,\n    output logic                   in_ready,\n    input  logic [DATA_WIDTH-1:0]  in_data,\n    output logic                   out_valid,\n    input  logic                   out_ready,\n    output logic [DATA_WIDTH-1:0]  out_data\n);\n\n    logic input_transfer, output_transfer;\n\n    assign in_ready = !out_valid || out_ready;\n    assign input_transfer  = in_valid && in_ready;\n    assign output_transfer = out_valid && out_ready;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            out_valid <= 1'b0;\n            out_data  <= '0;\n        end else begin\n            out_valid <= input_transfer ? 1'b1 : (output_transfer ? 1'b0 : out_valid);\n            out_data  <= input_transfer ? in_data : out_data;\n        end\n    end\n\nendmodule\n"
    },
