    "rtl": {
      "language": "systemverilog",
      "module_name": "serial_parity",
      "code": "module serial_parity (\n    input  logic clk,\n    input  logic rst,\n    input  logic start,\n    input  logic bit_valid,\n    input  logic bit_in,\n    input  logic finish,\n    output logic busy,\n    output logic parity,\n    output logic done\n);\n\n    logic busy_r;\n    logic acc_r;\n    logic parity_r;\n    logic done_r;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            busy_r   <= 1'b0;\n            acc_r    <= 1'b0;\n            parity_r <= 1'b0;\n            done_r   <= 1'b0;\n        end else begin\n            busy_r   <= busy_r;\n            acc_r    <= acc_r;\n            parity_r <= parity_r;\n            done_r   <= 1'b0;\n\n            if (start && !busy_r) begin\n                busy_r <= 1'b1;\n                acc_r  <= bit_valid ? bit_in : 1'b0;\n            end else if (busy_r) begin\n                if (finish) begin\n                    acc_r    <= bit_valid ? (acc_r ^ bit_in) : acc_r;\n                    parity_r <= bit_valid ? (acc_r ^ bit_in) : acc_r;\n                    busy_r   <= 1'b0;\n                    done_r   <= 1'b1;\n                end else if (bit_valid) begin\n                    acc_r <= acc_r ^ bit_in;\n                end\n            end\n        end\n    end\n\n    assign busy  = busy_r;\n    assign parity = parity_r;\n    assign done  = done_r;\n\nendmodule\n"
    },
