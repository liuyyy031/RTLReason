    "rtl": {
      "language": "systemverilog",
      "module_name": "round_robin_arbiter",
      "code": "module round_robin_arbiter (\n  input  logic        clk,\n  input  logic        rst,\n  input  logic [3:0]  req,\n  output logic [3:0]  grant\n);\n  logic [1:0] ptr;\n  logic [3:0] grant_r;\n  logic [3:0] next_grant;\n  logic [1:0] next_ptr;\n\n  always_comb begin\n    next_grant = 4'b0;\n    next_ptr = ptr;\n    for (int i = 0; i < 4; i++) begin\n      logic [1:0] idx;\n      idx = ptr + 2'(i);\n      if (next_grant == 4'b0 && req[idx]) begin\n        next_grant = (4'b1 << idx);\n        next_ptr = idx + 1'b1;\n      end\n    end\n  end\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      grant_r <= 4'b0;\n      ptr <= 2'b0;\n    end else begin\n      grant_r <= next_grant;\n      ptr <= next_ptr;\n    end\n  end\n\n  assign grant = grant_r;\nendmodule\n"
    },
