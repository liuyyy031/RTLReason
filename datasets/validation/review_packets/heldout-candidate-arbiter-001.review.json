    "rtl": {
      "language": "systemverilog",
      "module_name": "round_robin_arbiter",
      "code": "module round_robin_arbiter (\n    input  logic        clk,\n    input  logic        rst,\n    input  logic [3:0]  req,\n    output logic [3:0]  grant\n);\n\n    logic [1:0] ptr;\n    logic [1:0] ptr_next;\n    logic [3:0] grant_next;\n    logic [3:0] req_rot;\n    logic [1:0] first_idx;\n    logic       no_req;\n\n    // rotate req left by ptr so scan starts at ptr\n    always_comb begin\n        case (ptr)\n            2'd0: req_rot = req;\n            2'd1: req_rot = {req[0], req[3], req[2], req[1]};\n            2'd2: req_rot = {req[1], req[0], req[3], req[2]};\n            2'd3: req_rot = {req[2], req[1], req[0], req[3]};\n        endcase\n    end\n\n    // priority encoder for first set bit (LSB first)\n    always_comb begin\n        if (req_rot[0])      first_idx = 2'd0;\n        else if (req_rot[1]) first_idx = 2'd1;\n        else if (req_rot[2]) first_idx = 2'd2;\n        else if (req_rot[3]) first_idx = 2'd3;\n        else                 first_idx = 2'd0;\n        no_req = ~|req_rot;\n    end\n\n    // next-state grant and pointer\n    always_comb begin\n        grant_next = 4'b0;\n        if (!no_req) begin\n            case ((first_idx + ptr) % 4)\n                2'd0: grant_next = 4'b0001;\n                2'd1: grant_next = 4'b0010;\n                2'd2: grant_next = 4'b0100;\n                2'd3: grant_next = 4'b1000;\n            endcase\n            ptr_next = (first_idx + ptr + 1) % 4;\n        end else begin\n            ptr_next = ptr;\n        end\n    end\n\n    // synchronous reset and registered outputs\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            grant <= 4'b0;\n            ptr   <= 2'b0;\n        end else begin\n            grant <= grant_next;\n            ptr   <= ptr_next;\n        end\n    end\n\nendmodule"
    },
