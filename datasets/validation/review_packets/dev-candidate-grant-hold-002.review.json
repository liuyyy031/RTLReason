    "rtl": {
      "language": "systemverilog",
      "module_name": "grant_hold_arbiter",
      "code": "module grant_hold_arbiter (\n  input  logic        clk,\n  input  logic        rst,\n  input  logic [3:0]  req,\n  input  logic        accept,\n  output logic [3:0]  grant\n);\n  logic [3:0] grant_reg;\n  logic [3:0] next_grant;\n  logic [3:0] sel_grant;\n\n  always_comb begin\n    sel_grant = 4'b0000;\n    if (req[0])      sel_grant = 4'b0001;\n    else if (req[1]) sel_grant = 4'b0010;\n    else if (req[2]) sel_grant = 4'b0100;\n    else if (req[3]) sel_grant = 4'b1000;\n  end\n\n  always_comb begin\n    if (grant_reg != 4'b0000)\n      next_grant = accept ? 4'b0000 : grant_reg;\n    else\n      next_grant = sel_grant;\n  end\n\n  always_ff @(posedge clk) begin\n    if (rst)\n      grant_reg <= 4'b0000;\n    else\n      grant_reg <= next_grant;\n  end\n\n  assign grant = grant_reg;\nendmodule\n"
    },
