    "rtl": {
      "language": "systemverilog",
      "module_name": "uart_rx",
      "code": "module uart_rx #(parameter int CLKS_PER_BIT = 4) (input logic clk, input logic rst, input logic rx, output logic [7:0] data_out, output logic data_valid, output logic framing_error, output logic busy);\n  localparam int FULL = CLKS_PER_BIT;\n  localparam int HALF = CLKS_PER_BIT / 2;\n  typedef enum logic [1:0] {IDLE, START_WAIT, DATA_WAIT, STOP_WAIT} state_t;\n  state_t state;\n  logic [15:0] timer;\n  logic [2:0] data_bit;\n  logic [7:0] data_reg;\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      state <= IDLE; timer <= 0; data_bit <= 0; data_reg <= 0;\n      data_out <= 0; data_valid <= 0; framing_error <= 0; busy <= 0;\n    end else begin\n      data_valid <= 0; framing_error <= 0;\n      case (state)\n        IDLE: begin\n          busy <= 0;\n          if (!busy && rx == 1'b0) begin\n            state <= START_WAIT; timer <= HALF; busy <= 1;\n            data_bit <= 0; data_reg <= 0;\n          end\n        end\n        START_WAIT: begin\n          if (timer == 1) begin\n            if (rx == 1'b1) begin\n              state <= IDLE; busy <= 0; timer <= 0;\n            end else begin\n              state <= DATA_WAIT; timer <= FULL;\n            end\n          end else timer <= timer - 1;\n        end\n        DATA_WAIT: begin\n          if (timer == 1) begin\n            data_reg[data_bit] <= rx;\n            if (data_bit == 3'd7) begin\n              state <= STOP_WAIT; timer <= FULL;\n            end else begin\n              data_bit <= data_bit + 1; timer <= FULL;\n            end\n          end else timer <= timer - 1;\n        end\n        STOP_WAIT: begin\n          if (timer == 1) begin\n            data_out <= data_reg; data_valid <= 1'b1;\n            framing_error <= (rx == 1'b0);\n            state <= IDLE; busy <= 0; timer <= 0;\n          end else timer <= timer - 1;\n        end\n        default: state <= IDLE;\n      endcase\n    end\n  end\nendmodule"
    },
    "metadata": {
      "notes": [
        "Timer load equals desired clock interval; sample occurs when timer==1.",
        "False start returns to IDLE without outputs."
