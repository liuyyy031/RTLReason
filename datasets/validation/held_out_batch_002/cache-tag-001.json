    "rtl": {
      "language": "systemverilog",
      "module_name": "cache_tag_lookup",
      "code": "module cache_tag_lookup #(\n    parameter int WAYS = 4,\n    parameter int TAG_WIDTH = 6,\n    parameter int DATA_WIDTH = 8\n) (\n    input  logic [TAG_WIDTH-1:0] lookup_tag,\n    input  logic [WAYS-1:0] valid,\n    input  logic [WAYS*TAG_WIDTH-1:0] tags,\n    input  logic [WAYS*DATA_WIDTH-1:0] data,\n    output logic hit,\n    output logic [$clog2(WAYS)-1:0] hit_way,\n    output logic [DATA_WIDTH-1:0] hit_data\n);\n    localparam int WAY_WIDTH = $clog2(WAYS);\n    logic [WAYS-1:0] match_vec;\n    logic [WAYS-1:0] hit_onehot;\n\n    for (genvar i=0; i<WAYS; i++) begin : gen_match\n        assign match_vec[i] = valid[i] & (tags[i*TAG_WIDTH +: TAG_WIDTH] == lookup_tag);\n    end\n\n    for (genvar i=0; i<WAYS; i++) begin : gen_pri\n        if (i==0) begin\n            assign hit_onehot[i] = match_vec[i];\n        end else begin\n            assign hit_onehot[i] = match_vec[i] & ~(|match_vec[i-1:0]);\n        end\n    end\n\n    assign hit = |match_vec;\n\n    always_comb begin\n        hit_way = '0;\n        hit_data = '0;\n        for (int i=0; i<WAYS; i++) begin\n            if (hit_onehot[i]) begin\n                hit_way = WAY_WIDTH'(i);\n                hit_data = data[i*DATA_WIDTH +: DATA_WIDTH];\n            end\n        end\n    end\nendmodule\n"
    },
    "metadata": {
      "notes": [
        "No clock or reset ports; fully combinational.",
