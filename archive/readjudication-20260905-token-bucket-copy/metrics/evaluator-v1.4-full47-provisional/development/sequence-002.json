    "rtl": {
      "language": "systemverilog",
      "module_name": "sequence_detector_1011",
      "code": "module sequence_detector_1011 (\n  input  logic clk,\n  input  logic rst,\n  input  logic bit_valid,\n  input  logic bit_in,\n  output logic match\n);\n  localparam logic [1:0] IDLE = 2'd0, PRE1 = 2'd1, PRE10 = 2'd2, PRE101 = 2'd3;\n  logic [1:0] st, next_st;\n  logic next_match;\n\n  always_comb begin\n    next_st = st;\n    next_match = 1'b0;\n    if (bit_valid) begin\n      case (st)\n        IDLE:   if (bit_in) next_st = PRE1; else next_st = IDLE;\n        PRE1:   if (~bit_in) next_st = PRE10; else next_st = PRE1;\n        PRE10:  if (bit_in) next_st = PRE101; else next_st = IDLE;\n        PRE101: if (bit_in) begin next_match = 1'b1; next_st = PRE1; end\n                else next_st = PRE10;\n        default: next_st = IDLE;\n      endcase\n    end\n  end\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      st <= IDLE;\n      match <= 1'b0;\n    end else begin\n      st <= next_st;\n      match <= next_match;\n    end\n  end\nendmodule"
    },
