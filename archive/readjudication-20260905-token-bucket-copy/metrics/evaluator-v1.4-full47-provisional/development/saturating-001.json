    "rtl": {
      "language": "systemverilog",
      "module_name": "saturating_counter",
      "code": "module saturating_counter #(parameter WIDTH = 8) (\n  input  wire clk,\n  input  wire rst,\n  input  wire en,\n  input  wire up,\n  output wire [WIDTH-1:0] count,\n  output wire at_min,\n  output wire at_max\n);\n  logic [WIDTH-1:0] count_reg;\n  assign count = count_reg;\n  assign at_min = (count_reg == '0);\n  assign at_max = (count_reg == (2**WIDTH - 1));\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      count_reg <= '0;\n    end else if (en) begin\n      if (up && !at_max) begin\n        count_reg <= count_reg + 1'b1;\n      end else if (!up && !at_min) begin\n        count_reg <= count_reg - 1'b1;\n      end\n    end\n  end\nendmodule\n"
    },
