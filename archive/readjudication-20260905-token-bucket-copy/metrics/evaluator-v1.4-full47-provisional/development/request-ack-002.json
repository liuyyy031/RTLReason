    "rtl": {
      "language": "systemverilog",
      "module_name": "request_ack_timeout",
      "code": "module request_ack_timeout #(\n    parameter int TIMEOUT_CYCLES = 4\n) (\n    input  logic clk,\n    input  logic rst,\n    input  logic req,\n    input  logic ack,\n    output logic busy,\n    output logic done,\n    output logic timeout\n);\n\n    localparam int CNT_W = $clog2(TIMEOUT_CYCLES+1);\n    logic [CNT_W-1:0] cnt;\n    logic [CNT_W-1:0] cnt_next;\n    logic             busy_next, done_next, timeout_next;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            busy <= 1'b0;\n            done <= 1'b0;\n            timeout <= 1'b0;\n            cnt <= '0;\n        end else begin\n            busy <= busy_next;\n            done <= done_next;\n            timeout <= timeout_next;\n            cnt <= cnt_next;\n        end\n    end\n\n    always_comb begin\n        busy_next = busy;\n        done_next = 1'b0;\n        timeout_next = 1'b0;\n        cnt_next = cnt;\n        if (!busy) begin\n            if (req) begin\n                busy_next = 1'b1;\n                cnt_next = CNT_W'(TIMEOUT_CYCLES);\n            end\n        end else begin\n            if (ack) begin\n                busy_next = 1'b0;\n                done_next = 1'b1;\n            end else if (cnt == 1) begin\n                busy_next = 1'b0;\n                timeout_next = 1'b1;\n                cnt_next = '0;\n            end else begin\n                cnt_next = cnt - 1'b1;\n            end\n        end\n    end\nendmodule\n"
    },
