    "rtl": {
      "language": "systemverilog",
      "module_name": "stream_width_adapter",
      "code": "module stream_width_adapter (\n    input  logic        clk,\n    input  logic        rst,\n    input  logic        in_valid,\n    output logic        in_ready,\n    input  logic [7:0]  in_data,\n    output logic        out_valid,\n    input  logic        out_ready,\n    output logic [15:0] out_data\n);\n\n    logic        stored;\n    logic [7:0]  low_byte;\n\n    assign in_ready = !out_valid;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            stored    <= 1'b0;\n            low_byte  <= 8'h00;\n            out_valid <= 1'b0;\n            out_data  <= 16'h0000;\n        end else begin\n            if (out_valid && out_ready) begin\n                out_valid <= 1'b0;\n            end\n            if (in_valid && in_ready) begin\n                if (!stored) begin\n                    low_byte <= in_data;\n                    stored   <= 1'b1;\n                end else begin\n                    out_data <= {in_data, low_byte};\n                    out_valid <= 1'b1;\n                    stored   <= 1'b0;\n                end\n            end\n        end\n    end\n\nendmodule\n"
    },
