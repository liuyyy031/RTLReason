    "rtl": {
      "language": "systemverilog",
      "module_name": "programmable_timer",
      "code": "module programmable_timer #(parameter int WIDTH = 8) (\n  input  logic             clk,\n  input  logic             rst,\n  input  logic             load,\n  input  logic [WIDTH-1:0] period,\n  input  logic             enable,\n  output logic [WIDTH-1:0] remaining,\n  output logic             tick\n);\n\n  logic [WIDTH-1:0] stored_period_reg;\n  logic [WIDTH-1:0] remaining_reg;\n  logic             tick_reg;\n  logic [WIDTH-1:0] eff_period;\n\n  assign eff_period = (period == {WIDTH{1'b0}}) ? WIDTH'(1) : period;\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      stored_period_reg <= WIDTH'(1);\n      remaining_reg     <= WIDTH'(1);\n      tick_reg          <= 1'b0;\n    end else if (load) begin\n      stored_period_reg <= eff_period;\n      remaining_reg     <= eff_period;\n      tick_reg          <= 1'b0;\n    end else if (enable) begin\n      if (remaining_reg == WIDTH'(1)) begin\n        tick_reg     <= 1'b1;\n        remaining_reg <= stored_period_reg;\n      end else begin\n        remaining_reg <= remaining_reg - WIDTH'(1);\n        tick_reg      <= 1'b0;\n      end\n    end else begin\n      tick_reg <= 1'b0;\n    end\n  end\n\n  assign remaining = remaining_reg;\n  assign tick = tick_reg;\nendmodule"
    },
    "metadata": {
      "notes": [
        "Single always_ff with combinational clamping; priority via if-else ordering."
