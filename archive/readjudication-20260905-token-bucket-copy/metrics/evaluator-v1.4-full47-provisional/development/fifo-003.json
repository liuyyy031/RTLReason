    "rtl": {
      "language": "systemverilog",
      "module_name": "fifo_sync",
      "code": "module fifo_sync #(\n  parameter integer DATA_WIDTH = 8,\n  parameter integer DEPTH = 4\n) (\n  input  wire                  clk,\n  input  wire                  rst,\n  input  wire                  wr_en,\n  input  wire                  rd_en,\n  input  wire [DATA_WIDTH-1:0] din,\n  output reg  [DATA_WIDTH-1:0] dout,\n  output wire                  full,\n  output wire                  empty\n);\n\n  logic [DATA_WIDTH-1:0] mem [0:DEPTH-1];\n  logic [$clog2(DEPTH)-1:0] wptr;\n  logic [$clog2(DEPTH)-1:0] rptr;\n  logic [$clog2(DEPTH+1)-1:0] cnt;\n\n  assign full  = (cnt == DEPTH);\n  assign empty = (cnt == 0);\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      cnt  <= '0;\n      wptr <= '0;\n      rptr <= '0;\n      dout <= '0;\n    end else begin\n      logic accept_write;\n      logic accept_read;\n      accept_read  = rd_en && (cnt > 0);\n      accept_write = wr_en && ((cnt < DEPTH) || (rd_en && cnt > 0));\n      if (accept_write) begin\n        mem[wptr] <= din;\n        wptr <= (wptr == DEPTH-1) ? '0 : wptr + 1'b1;\n      end\n      if (accept_read) begin\n        dout <= mem[rptr];\n        rptr <= (rptr == DEPTH-1) ? '0 : rptr + 1'b1;\n      end\n      cnt <= cnt + (accept_write ? 1'b1 : 1'b0) - (accept_read ? 1'b1 : 1'b0);\n    end\n  end\nendmodule"
    },
    "metadata": {
      "notes": [
        "Ring buffer chosen; no bypass for empty simultaneous read/write as required.",
        "Pointers use modulo wrap via compare to DEPTH-1."
