    "rtl": {
      "language": "systemverilog",
      "module_name": "ready_valid_slice",
      "code": "module ready_valid_slice #(\n    parameter int DATA_WIDTH = 8\n) (\n    input  logic                   clk,\n    input  logic                   rst,\n    input  logic                   in_valid,\n    output logic                   in_ready,\n    input  logic [DATA_WIDTH-1:0] in_data,\n    output logic                   out_valid,\n    input  logic                   out_ready,\n    output logic [DATA_WIDTH-1:0] out_data\n);\n\n    logic                   entry_valid;\n    logic [DATA_WIDTH-1:0] entry_data;\n\n    assign in_ready = !entry_valid || out_ready;\n    assign out_valid = entry_valid;\n    assign out_data  = entry_data;\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            entry_valid <= 1'b0;\n            entry_data  <= '0;\n        end else begin\n            if (entry_valid) begin\n                if (out_ready) begin\n                    if (in_valid) begin\n                        entry_data  <= in_data;\n                        entry_valid <= 1'b1;\n                    end else begin\n                        entry_valid <= 1'b0;\n                    end\n                end else begin\n                    entry_valid <= 1'b1;\n                end\n            end else begin\n                if (in_valid) begin\n                    entry_data  <= in_data;\n                    entry_valid <= 1'b1;\n                end else begin\n                    entry_valid <= 1'b0;\n                end\n            end\n        end\n    end\n\nendmodule"
    },
