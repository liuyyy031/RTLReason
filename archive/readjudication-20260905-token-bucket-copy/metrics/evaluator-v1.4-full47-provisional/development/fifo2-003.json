    "rtl": {
      "language": "systemverilog",
      "module_name": "ready_valid_fifo2",
      "code": "module ready_valid_fifo2 #(\n  parameter DATA_WIDTH = 8\n) (\n  input  logic                    clk,\n  input  logic                    rst,\n  input  logic                    in_valid,\n  output logic                    in_ready,\n  input  logic [DATA_WIDTH-1:0]   in_data,\n  output logic                    out_valid,\n  input  logic                    out_ready,\n  output logic [DATA_WIDTH-1:0]   out_data\n);\n\n  // Storage registers\n  logic [DATA_WIDTH-1:0] data [0:1];\n  logic [1:0]            occupancy;  // 0,1,2\n  logic                  head;       // 0 or 1, points to oldest valid entry\n\n  // Combinational outputs\n  assign out_valid = (occupancy != 0);\n  assign out_data  = out_valid ? data[head] : {DATA_WIDTH{1'b0}};\n  assign in_ready  = (occupancy < 2) || (out_valid && out_ready);\n\n  // Input and output transfer signals\n  logic input_transfer, output_transfer;\n  assign input_transfer  = in_valid && in_ready;\n  assign output_transfer = out_valid && out_ready;\n\n  // Next state signals\n  logic [1:0] next_occupancy;\n  logic       next_head;\n  logic       write_en;\n  logic       write_addr;  // 0 or 1\n  logic [DATA_WIDTH-1:0] write_data;\n\n  always_comb begin\n    // Default: no change\n    next_occupancy = occupancy;\n    next_head      = head;\n    write_en       = 1'b0;\n    write_addr     = 'x;\n    write_data     = 'x;\n\n    unique case ({input_transfer, output_transfer})\n      2'b11: begin\n        if (occupancy == 1) begin\n          // Simultaneous with one entry: consume old, accept new\n          // Write new input to tail slot (the empty one)\n          write_addr = (head + 1) % 2;\n          write_data = in_data;\n          write_en   = 1'b1;\n          next_head  = write_addr;  // new head is the written slot\n          next_occupancy = 1;\n        end else if (occupancy == 2) begin\n          // Simultaneous full: consume oldest, accept new into same slot\n          write_addr = head;\n          write_data = in_data;\n          write_en   = 1'b1;\n          next_head  = (head + 1) % 2;\n          next_occupancy = 2;\n        end\n        // occupancy == 0 impossible because output_transfer requires out_valid\n      end\n      2'b10: begin // input only\n        if (occupancy == 0) begin\n          write_addr = head;\n          write_data = in_data;\n          write_en   = 1'b1;\n          next_head      = head;  // unchanged, only one entry\n          next_occupancy = 1;\n        end else if (occupancy == 1) begin\n          write_addr = (head + 1) % 2;\n          write_data = in_data;\n          write_en   = 1'b1;\n          next_head      = head;  // head unchanged\n          next_occupancy = 2;\n        end\n        // occupancy == 2: cannot happen because in_ready would be false\n      end\n      2'b01: begin // output only\n        if (occupancy == 1) begin\n          next_occupancy = 0;\n          // head unchanged (will be overwritten on next input write)\n        end else if (occupancy == 2) begin\n          next_occupancy = 1;\n          next_head = (head + 1) % 2;\n        end\n        // occupancy == 0 impossible\n      end\n      default: ; // no transfer\n    endcase\n  end\n\n  // Sequential logic\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      occupancy <= 0;\n      head      <= 0;\n      data[0]   <= {DATA_WIDTH{1'b0}};\n      data[1]   <= {DATA_WIDTH{1'b0}};\n    end else begin\n      occupancy <= next_occupancy;\n      head      <= next_head;\n      if (write_en) begin\n        data[write_addr] <= write_data;\n      end\n    end\n  end\n\nendmodule\n"
    },
