    "rtl": {
      "language": "systemverilog",
      "module_name": "stream_width_adapter",
      "code": "module stream_width_adapter (\n  input  logic        clk,\n  input  logic        rst,\n  input  logic        in_valid,\n  output logic        in_ready,\n  input  logic [7:0]  in_data,\n  output logic        out_valid,\n  input  logic        out_ready,\n  output logic [15:0] out_data\n);\n\n  // Registers\n  logic        has_low;\n  logic [7:0]  low_byte;\n  logic        out_valid_r;\n  logic [15:0] out_data_r;\n\n  // Combinational\n  assign in_ready = !out_valid_r;\n\n  always_ff @(posedge clk) begin\n    if (rst) begin\n      has_low     <= 1'b0;\n      low_byte    <= 8'b0;\n      out_valid_r <= 1'b0;\n      out_data_r  <= 16'b0;\n    end else begin\n      // Output acceptance\n      if (out_valid_r && out_ready) begin\n        out_valid_r <= 1'b0;\n        // out_data_r retains value\n      end\n\n      // Input acceptance\n      if (in_ready && in_valid) begin\n        if (!has_low) begin\n          // First byte\n          has_low  <= 1'b1;\n          low_byte <= in_data;\n        end else begin\n          // Second byte\n          out_data_r  <= {in_data, low_byte}; // high byte is in_data, low byte is low_byte\n          out_valid_r <= 1'b1;\n          has_low     <= 1'b0;\n        end\n      end\n    end\n  end\n\n  // Output ports\n  assign out_valid = out_valid_r;\n  assign out_data  = out_data_r;\n\nendmodule\n"
    },
