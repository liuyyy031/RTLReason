    "rtl": {
      "language": "systemverilog",
      "module_name": "stream_width_adapter",
      "code": "module stream_width_adapter (\n    input  logic       clk,\n    input  logic       rst,\n    input  logic       in_valid,\n    output logic       in_ready,\n    input  logic [7:0]  in_data,\n    output logic       out_valid,\n    input  logic       out_ready,\n    output logic [15:0] out_data\n);\n\n    typedef enum logic [1:0] { EMPTY=2'b00, PARTIAL=2'b01, FULL=2'b10 } state_t;\n    state_t state, next_state;\n    logic [7:0] low_byte;\n    logic [15:0] next_out_data;\n    logic next_out_valid;\n\n    always_comb begin\n        in_ready = (state != FULL);\n        next_state = state;\n        next_out_valid = out_valid;\n        next_out_data = out_data;\n        case (state)\n            EMPTY: begin\n                if (in_valid && in_ready) begin\n                    next_state = PARTIAL;\n                end\n            end\n            PARTIAL: begin\n                if (in_valid && in_ready) begin\n                    next_state = FULL;\n                    next_out_valid = 1'b1;\n                    next_out_data = {in_data, low_byte};\n                end\n            end\n            FULL: begin\n                if (out_ready) begin\n                    next_state = EMPTY;\n                    next_out_valid = 1'b0;\n                end\n            end\n        endcase\n    end\n\n    always_ff @(posedge clk) begin\n        if (rst) begin\n            state <= EMPTY;\n            low_byte <= 8'b0;\n            out_valid <= 1'b0;\n            out_data <= 16'b0;\n        end else begin\n            state <= next_state;\n            out_valid <= next_out_valid;\n            out_data <= next_out_data;\n            if (state == EMPTY && in_valid && in_ready) begin\n                low_byte <= in_data;\n            end\n        end\n    end\n\nendmodule\n"
    },
