{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlreason.local/schemas/process.schema.json",
  "title": "RTLReason S1-S5 Process Artifact",
  "type": "object",
  "required": ["task_id", "architecture_summary", "stages", "rtl"],
  "properties": {
    "task_id": {"type": "string"},
    "architecture_summary": {"type": "string"},
    "stages": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["id", "title", "items"],
        "properties": {
          "id": {"enum": ["S1", "S2", "S3", "S4", "S5"]},
          "title": {"type": "string"},
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "claim", "maps_to"],
              "properties": {
                "id": {"type": "string"},
                "claim": {"type": "string"},
                "maps_to": {"type": "array", "items": {"type": "string"}},
                "claimed_dependencies": {"type": "array", "items": {"type": "string"}},
                "reads": {"type": "array", "items": {"type": "string"}},
                "writes": {"type": "array", "items": {"type": "string"}},
                "rtl_blocks": {"type": "array", "items": {"type": "string"}}
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      }
    },
    "rtl": {
      "type": "object",
      "required": ["language", "module_name", "code"],
      "properties": {
        "language": {"type": "string"},
        "module_name": {"type": "string", "minLength": 1},
        "code": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
