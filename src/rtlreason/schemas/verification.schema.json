{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rtlreason.local/schemas/verification.schema.json",
  "title": "RTLReason Per-Task Verification Manifest",
  "type": "object",
  "required": ["schema_version", "simulation", "formal"],
  "properties": {
    "schema_version": {"type": "string"},
    "simulation": {
      "type": "object",
      "required": ["testbench", "top"],
      "properties": {
        "testbench": {"type": "string", "minLength": 1},
        "top": {"type": "string", "minLength": 1},
        "vcd": {"type": "string"}
      },
      "additionalProperties": false
    },
    "formal": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": {"type": "boolean"},
        "harness": {"type": "string"},
        "top": {"type": "string"},
        "depth": {"type": "integer", "minimum": 1},
        "obligations": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
